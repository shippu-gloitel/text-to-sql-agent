NODE_ENV=development

# Optional: require HTTP Basic authentication for the app and all API routes.
# Strongly recommended whenever the app is reachable by anyone other than you.
# APP_BASIC_AUTH=admin:change-me

# Optional: only allow PostgreSQL/MySQL connections to these hosts (comma-separated).
# ALLOWED_DB_HOSTS=localhost,db.internal.example.com

# Optional: only allow custom OpenAI-compatible model endpoints on these hosts (comma-separated).
# ALLOWED_MODEL_HOSTS=localhost,models.internal.example.com

# Optional: only allow SQLite files inside these directories (comma-separated).
# SQLITE_ALLOWED_DIRS=/srv/data
