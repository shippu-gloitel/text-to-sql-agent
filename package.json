{
  "name": "text-to-sql-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "==============================UTILS=====================================================================": "",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "rm -rf .husky && husky && echo \"bun install\" > .husky/post-merge && chmod +x .husky/post-merge && echo \"bun run lint-staged\" > .husky/pre-commit && chmod +x .husky/pre-commit && echo \"bun run build\" > .husky/pre-push && chmod +x .husky/pre-push",
    "===============================CLEANUP============================================================": "",
    "cleanup": "rm -rf node_modules .next *.tsbuildinfo .husky logs",
    "build:test": "bun run typecheck && bun run format && bun run lint && bun run build",
    "cid": "bun run cleanup && bun install && bun run build:test"
  },
  "lint-staged": {
    "**/*.{jsx,tsx,js,cjs,mjs,ts,cts,mts,json,jsonc,md}": [
      "bun run format"
    ]
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint-config-next": "16.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
